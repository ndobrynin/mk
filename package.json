{
  "name": "kidagrad",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "echo skip",
    "dev:api": "pnpm --filter @kidagrad/api dev",
