generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  identities    Identity[]
  refreshTokens RefreshToken[]
  hostedRooms   Room[]
  roomSeats     RoomSeat[]

  @@map("users")
}

model Identity {
  id         String @id @default(uuid())
  userId     String
  provider   String
  providerId String

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("identities")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Room {
  id         String   @id @default(uuid())
  code       String   @unique
  hostUserId String
  maxSeats   Int
  isPublic   Boolean  @default(false)
  status     String   @default("waiting")
  createdAt  DateTime @default(now())

  host  User       @relation(fields: [hostUserId], references: [id])
  seats RoomSeat[]

  @@map("rooms")
}

model RoomSeat {
  id        String @id @default(uuid())
  roomId    String
  userId    String
  seatIndex Int

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@unique([roomId, seatIndex])
  @@map("room_seats")
}
